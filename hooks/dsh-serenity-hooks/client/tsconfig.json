{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["react", "react/jsx-runtime"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    // ── 宿主类型基准（v1.31.11 §7-8 同 node 半同步）─────────────────────────────
    // baseUrl = client/，故路径为 `../node_modules/@deepseek-ai/<pkg>`（node_modules 在 hooks/）。
    // 旧形态两处指向 `~/.dsh/source/current/packages/client/ui-{slots,primitives}`（**DSH 源码检出**，
    // 比 .npm-global 更脆）→ 已实证 npm 包自带 `lib/types/`，故一并改为 devDependencies 解析。
    // 纪律同 node 半：新增条目必须加进 devDependencies；cordis 双映射必须同实体。
    "paths": {
      // v1.28.0 适配 0.1.2-rc.1（A1）：dsh-client-runtime 包已删 →
      // ClientContext 用官方同款 `Context as ClientContext` from '@deepseek-ai/cordis'；
      // SettingsScope/SettingsScopeSpec 从 '@deepseek-ai/dsh-client-ui-settings/client'（官方再导出）
      "@deepseek-ai/cordis": ["../node_modules/@deepseek-ai/cordis"],
      "cordis": ["../node_modules/@deepseek-ai/cordis"],
      "@deepseek-ai/dsh-client-ui-settings": ["../node_modules/@deepseek-ai/dsh-client-ui-settings/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-settings/client": ["../node_modules/@deepseek-ai/dsh-client-ui-settings/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-renderer": ["../node_modules/@deepseek-ai/dsh-client-ui-renderer/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-renderer/client": ["../node_modules/@deepseek-ai/dsh-client-ui-renderer/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-slots": ["../node_modules/@deepseek-ai/dsh-client-ui-slots/lib/types/index.d.ts"],
      // v1.51.2 diagram 图片行的**宿主槽契约**来源：`SlotMap['tool.call.toolview']` 只由 ui-tool 声明。
      // 为什么必须进 paths、而不是本地 `declare module` 抄一份（F7 / README §9「宿主类型基准 = devDependencies」）：
      // 抄一份 ⇒ 槽类型在**拿不到真契约**时也编译通过 = F7 要防的假绿，且「宿主槽契约变了」变成**我们不知道**；
      // 接上真契约后 `typecheck-host <ver>` 才会在宿主升级时自动抓住类型面漂移。
      // 纪律：新增 paths 条目**必须**同时加 devDependency（已加 `@deepseek-ai/dsh-client-ui-tool@0.1.7-rc.1`），
      // 否则 tsc 静默回落 node_modules —— compliance F7b 钉这一条。
      "@deepseek-ai/dsh-client-ui-tool/client": ["../node_modules/@deepseek-ai/dsh-client-ui-tool/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-primitives": ["../node_modules/@deepseek-ai/dsh-client-ui-primitives/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-conversation": ["../node_modules/@deepseek-ai/dsh-client-ui-conversation/lib/types/client/index.d.ts"],
      // v1.51.3 `conversation.chat.turnTail` 的**槽契约与快照类型**来源：`SlotMap['conversation.chat.turnTail']`
      // 与 `ConversationViewSnapshotMap['chat']`（= ChatSnapshot：locations/nodes/timeline）都只由本包声明。
      // 🔴 与 ui-tool 同规矩（v1.51.2 实测）：没有 import 时该 .d.ts **不进 program** ⇒ 槽名被判"不在 SlotMap"。
      "@deepseek-ai/dsh-client-ui-chat/client": ["../node_modules/@deepseek-ai/dsh-client-ui-chat/lib/types/client/index.d.ts"],
      // 🔴 v1.51.3 实测（`typecheck-host 0.2.0-rc.1` 抓到的**升级漂移**）：**宿主自己的 .d.ts 里**
      // 用的模块说明符，也必须在 paths 里有一条 —— ui-chat 的 `contract/snapshot.d.ts` 写着
      // `declare module '@deepseek-ai/dsh-client-ui-conversation/client'`，而此前只钉了**裸名**那一条
      // ⇒ 派生宿主 tsconfig 里 `/client` 这形态没有映射 ⇒ 回落 node 解析到**本机 node_modules 的另一版本**
      // ⇒ **模块身份分裂** ⇒ 那句增强合并不进去（症状：`binding().target('chat')` 的参数类型变成 `never`）。
      // 判据 = 同一句话的两种写法（裸名 / `/client`）必须指向**同一个文件**。
      "@deepseek-ai/dsh-client-ui-conversation/client": ["../node_modules/@deepseek-ai/dsh-client-ui-conversation/lib/types/client/index.d.ts"],
      // 🔴 v1.51.3 实测第二条（同族，但根因在**宿主包自己的传递类型依赖**）：ui-conversation 的
      // `records.d.ts` 第 4 行 `import type { ImageAttachmentRef } from '@deepseek-ai/dsh-attachment'`
      // —— 不钉它 ⇒ 解包宿主那份（纯目录、**没有兄弟 node_modules**）解析不到 ⇒ `skipLibCheck` 下
      // 静默退化成 `any` ⇒ `host-type-contract.ts` §④ 的**品牌断言**当场红（`Extends<string, any>` 恒真）。
      // 钉它之后：本机 program 用 pnpm 那份、宿主 program 用解包那份，两边都是**真类型**。
      "@deepseek-ai/dsh-attachment": ["../node_modules/@deepseek-ai/dsh-attachment/lib/types/index.d.ts"],
      // 同族的**第二跳**：`AttachmentId = Branded<'AttachmentId'>`（`dsh-attachment/brand.d.ts` 里
      // `import type { Branded } from '@deepseek-ai/dsh-brand'`）⇒ 不钉 `dsh-brand` 则品牌类型同样退化。
      "@deepseek-ai/dsh-brand": ["../node_modules/@deepseek-ai/dsh-brand/lib/types/index.d.ts"],
      // 同族**第三跳**：`records.d.ts` 的 `content: readonly ContentBlock[]` 里
      // `ContentBlock` 来自 `@deepseek-ai/dsh-llm/types` —— 不钉它，宿主那份会**按 node 解析**到
      // 另一个版本 ⇒ 联合类型的某个成员退化成 `any` ⇒ `Extract<…,{type:'image'}>` 整个变 `any`
      // （症状：`host-type-contract.ts` §④ 的**品牌断言**红，而"防 any"那条却绿 —— 极隐蔽）。
      "@deepseek-ai/dsh-llm/types": ["../node_modules/@deepseek-ai/dsh-llm/lib/types/types.d.ts"],
      "@deepseek-ai/dsh-llm/brand": ["../node_modules/@deepseek-ai/dsh-llm/lib/types/brand.d.ts"],
      // v1.31.6 适配 0.1.5-rc.1：session 作用域类型面抽到新包（sessionId / Context.sessions）
      "@deepseek-ai/dsh-client-ui-session": ["../node_modules/@deepseek-ai/dsh-client-ui-session/lib/types/client/index.d.ts"],
      // `Context.sessions` 的声明合并源（ui-session 只 import，不重复声明）——不映射则合并进不了 program
      "@deepseek-ai/dsh-api-session-controller/client": ["../node_modules/@deepseek-ai/dsh-api-session-controller/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-locale": ["../node_modules/@deepseek-ai/dsh-client-locale"],
      "react": ["../node_modules/@types/react"],
      "react/jsx-runtime": ["../node_modules/@types/react/jsx-runtime"],
      // v1.121.0：popover 改走 `createPortal`（宿主 0.2.2 给标题簇加了 `mask-image`，
      // mask 会**裁切 fixed 后代** ⇒ fixed 那条老逃生路在该档失效，宿主自己的槽位契约
      // 也明写 "overlays must portal"）。`react-dom` 在 `tsdown.config.ts` 的 PLATFORM_MODULES
      // 里是 external（运行时由宿主冻结模块表解析），**类型**则要靠这里 —— 与 `react` 同规矩：
      // paths 条目必须同时有 devDependency（已加 `@types/react-dom@^18.3.7`），否则 tsc 回落 = 假红。
      "react-dom": ["../node_modules/@types/react-dom"]
    }
  },
  "include": ["../src/client"]
}
